{
  "name": "rakib-ai-assistant",
  "version": "1.0.0",
  "description": "RAKIB PERSONAL AI ASSISTANT - Production-ready desktop AI application",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev -w packages/server\" \"npm run dev -w apps/desktop\"",
    "build": "npm run build -ws",
    "build:server": "npm run build -w packages/server",
    "build:desktop": "npm run build -w apps/desktop",
    "dev:server": "npm run dev -w packages/server",
    "dev:desktop": "npm run dev -w apps/desktop",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "db:migrate": "npm run db:migrate -w packages/server",
    "db:push": "npm run db:push -w packages/server",
    "db:seed": "npm run db:seed -w packages/server"
  },
  "workspaces": [
    "apps/desktop",
    "packages/server",
    "packages/shared"
  ],
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
